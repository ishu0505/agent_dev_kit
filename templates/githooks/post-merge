#!/bin/sh
# After a pull or a checkout, refresh the local files that connect your own
# maps to each agent (beside mode, in a team repo): the team's AGENTS.md may
# have changed. Never blocks.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
[ -f "$ROOT/.agents/kit/wire.sh" ] && sh "$ROOT/.agents/kit/wire.sh" --quiet >/dev/null 2>&1
exit 0
