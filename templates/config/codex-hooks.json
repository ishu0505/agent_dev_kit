{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.agents/kit/session-start.sh\" ] && exec sh \"$r/.agents/kit/session-start.sh\"; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.agents/kit/sessions.sh\" ] && exec sh \"$r/.agents/kit/sessions.sh\" turn codex; exit 0'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'r=$(git rev-parse --show-toplevel 2>/dev/null) && [ -f \"$r/.agents/kit/stop-hook.sh\" ] && exec sh \"$r/.agents/kit/stop-hook.sh\"; exit 0'"
          }
        ]
      }
    ]
  }
}
